# Generate DATABASE_PASSWORD locally; never commit your .env.
DATABASE_NAME=math_trainer
DATABASE_USERNAME=math_trainer
DATABASE_PASSWORD=

# Default loopback binding for local use or a VPS HTTPS reverse proxy.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
DATABASE_VOLUME_NAME=math-trainer-postgres-data

# Set false only for a local HTTP development/demo browser.
SESSION_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=

# Empty by default. Optional local demo: SPRING_PROFILES_ACTIVE=dev,demo
SPRING_PROFILES_ACTIVE=
DEMO_ADMIN_PASSWORD=
